# Copy to .env locally, or set these securely in Coolify.
# Never commit .env, real API tokens or passwords.
WEBLATE_BASE=weblate/weblate:2026.10.1.2
WEBLATE_SITE_DOMAIN=translate.example.com
WEBLATE_ALLOWED_HOSTS=translate.example.com
WEBLATE_SITE_TITLE=Community Translations
WEBLATE_ADMIN_EMAIL=admin@example.com
WEBLATE_SERVER_EMAIL=noreply@example.com
WEBLATE_DEFAULT_FROM_EMAIL=noreply@example.com
# Generate a unique password and set via Coolify secrets / secure environment.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Use 1 only behind an HTTPS terminating proxy.
WEBLATE_ENABLE_HTTPS=1
WEBLATE_REGISTRATION_OPEN=1
# Configure a real SMTP server before enabling outgoing notifications.
WEBLATE_EMAIL_HOST=127.0.0.1
